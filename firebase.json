{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "predeploy": ["npm run predeploy:firebase"]
  },
  "hosting": [
    {
      "target": "admin",
      "public": "web-admin/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/api{,/**}", "function": { "functionId": "api", "region": "asia-southeast1" } }
      ]
    },
    {
      "target": "customer",
      "public": "flutter-app/build/web",
      "predeploy": ["npm run build:flutter:deploy"],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/api{,/**}", "function": { "functionId": "api", "region": "asia-southeast1" } }
      ]
    }
  ]
}
