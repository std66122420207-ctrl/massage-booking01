{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20"
  },
  "hosting": [
    {
      "site": "massage-booking-ce032",
      "public": "web-admin/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/api{,/**}", "function": { "functionId": "api", "region": "asia-southeast1" } }
      ]
    },
    {
      "site": "massage-booking-customer",
      "public": "flutter-app/build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/api{,/**}", "function": { "functionId": "api", "region": "asia-southeast1" } }
      ]
    }
  ]
}
