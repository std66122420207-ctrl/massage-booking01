{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "predeploy": ["npm run predeploy:firebase"]
  },
  "hosting": [
    {
      "target": "admin",
      "public": "web-admin/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "customer",
      "public": "flutter-app/build/web",
      "predeploy": ["node scripts/build_flutter_web.js"],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
