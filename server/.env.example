# ============================================================
#  ไฟล์นี้คือ template — คัดลอกเป็น .env แล้วใส่ค่าจริง
#  cp .env.example .env
# ============================================================

PORT=3000

# Firebase Admin SDK
# ดาวน์โหลด serviceAccountKey.json จาก Firebase Console
# Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ThaiD API (Digital ID กรมการปกครอง) — ใช้มาตรฐาน OpenID Connect
THAID_CLIENT_ID=your-thaid-client-id
THAID_CLIENT_SECRET=your-thaid-client-secret
# ต้องมี /api นำหน้าเพราะ route ถูก mount ที่ /api/auth (ดู server/index.js)
# ต้องตรงกับ Redirect URI ที่ลงทะเบียนไว้กับกรมการปกครองเป๊ะๆ (ทีละตัวอักษร)
THAID_REDIRECT_URI=http://localhost:3000/api/auth/thaid/callback
THAID_API_BASE=https://imauth.bora.dopa.go.th
# ปกติไม่ต้องตั้งตัวนี้ (ระบบคำนวณจาก THAID_API_BASE ให้อัตโนมัติ) ตั้งเฉพาะกรณี
# กรมการปกครองให้ URL ที่ไม่ตรง pattern มาตรฐาน /.well-known/openid-configuration
# THAID_WELL_KNOWN_URL=https://imauth.bora.dopa.go.th/.well-known/openid-configuration
# scope ต้องตรงกับที่กรมการปกครองอนุมัติให้ client_id ของคุณ (เช็คตอนลงทะเบียน)
THAID_SCOPE="openid pid name given_name family_name birthdate"
# บาง provider ต้องการ client_secret_post แทน client_secret_basic (ปกติไม่ต้องแก้)
THAID_TOKEN_AUTH=basic

# จำลอง ThaiD login สำหรับพัฒนา/เดโม (ไม่ต้องมี client id จริงจากกรมการปกครอง)
# เปิดได้เฉพาะตอน NODE_ENV != production เท่านั้น (ปิดอัตโนมัติใน production
# ต่อให้ลืมตั้งค่านี้ทิ้งไว้เป็น true ก็ตาม) — ดูรายละเอียดใน README หัวข้อ "จำลอง ThaiD"
MOCK_THAID=true

# URL ของหน้าเว็บแอป (Flutter Web build) — ใช้ตอน redirect กลับหลัง ThaiD login สำเร็จ
APP_URL=http://localhost:3000

# JWT Secret (ตั้งค่าเป็น random string ยาวๆ)
JWT_SECRET=replace_with_random_secret_string_at_least_64_chars

# Frontend URL (สำหรับ CORS)
FRONTEND_URL=http://localhost:4000

# Google Sheets (ซิงค์ข้อมูลการจอง) — ใช้ Google Service Account
# วิธีตั้งค่า: ดู README หัวข้อ "ตั้งค่า Google Sheets"
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-from-the-url

# Gmail (ส่งอีเมลแจ้งคิวให้หมอนวดแต่ละคน) — ใช้ App Password ไม่ใช่รหัสผ่านจริง
# วิธีสร้าง App Password: ดู README หัวข้อ "ตั้งค่าอีเมล"
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
