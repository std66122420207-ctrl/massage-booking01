{
  "name": "massage-booking-production",
  "private": true,
  "main": "functions/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "start:server": "cd server && npm start",
    "test:server": "cd server && npm test",
    "test:booking-concurrency": "firebase emulators:exec --project demo-massage-booking-concurrency --only firestore \"node server/tests/bookingConcurrency.test.js\"",
    "predeploy:firebase": "npm run test:server && node --test server/tests/autoCall.test.js",
    "dev:admin": "python -m http.server 8081 --directory web-admin/public",
    "dev:flutter": "cd flutter-app && flutter run -d chrome --web-port 8080",
    "build:flutter": "cd flutter-app && flutter build web",
    "build:flutter:deploy": "node scripts/build_flutter_web.js",
    "test:flutter": "cd flutter-app && flutter test",
    "analyze:flutter": "cd flutter-app && flutter analyze"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.1.0",
    "googleapis": "^150.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
