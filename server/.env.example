# ============================================================
#  ไฟล์นี้คือ template — คัดลอกเป็น .env แล้วใส่ค่าจริง
#  cp .env.example .env
# ============================================================

PORT=3000

# Firebase Admin SDK
# ใช้ project จริงจาก Firebase Console — ค่าด้านล่างเป็นค่าเรียกใช้ local/dev ที่มีอยู่ใน repo
FIREBASE_PROJECT_ID=massage-booking-ce032
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ThaiD API (Digital ID กรมการปกครอง) — ใช้มาตรฐาน OpenID Connect
# ต้องใช้ Client ID / Client Secret จริงจากกรมการปกครองก่อนใช้งานจริง
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_REDIRECT_URI=http://localhost:3000/api/auth/thaid/callback
THAID_API_BASE=https://imauth.bora.dopa.go.th
THAID_SCOPE="openid pid name given_name family_name birthdate"
THAID_TOKEN_AUTH=basic

# จำลอง ThaiD login สำหรับเดโม (ต้องตั้งเป็น true เพื่อให้ระบบรันได้แบบ local/test)
DEMO_MODE=true
MOCK_THAID=true

# URL ของหน้าเว็บแอป (Flutter Web build) — ใช้ตอน redirect กลับหลัง ThaiD login สำเร็จ
APP_URL=http://localhost:3000

# JWT Secret (ตั้งค่าเป็น random string ยาวๆ)
JWT_SECRET=replace_with_random_secret_string_at_least_64_chars

# Frontend URL (สำหรับ CORS)
FRONTEND_URL=http://localhost:4000

# Google Sheets (ซิงค์ข้อมูลการจอง) — ใช้ Google Service Account จริงเมื่อพร้อม
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Gmail (ส่งอีเมลแจ้งคิวให้หมอนวดแต่ละคน) — ใช้ App Password จริงเมื่อพร้อม
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional SMS via Twilio (ถ้าไม่ตั้งค่า ระบบยังใช้ in-app notification และ push ได้)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
